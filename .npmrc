# pnpm settings for CyberSixSeven. See documents/05-tech-stack.md §7.

# Honour the `packageManager` field in package.json: pnpm self-switches to
# 11.26.0 even when a newer pnpm is on PATH. pnpm 12 is a ground-up Rust
# rewrite that removed 18 install flags without documenting them as breaking.
manage-package-manager-versions=true

# Fail the install rather than silently running on a Node below the Vitest 5
# floor (22.12). The repo targets Node 24.
engine-strict=true

# typescript-eslint 8.x declares `typescript: ">=4.8.4 <6.1.0"`. The repo runs
# TypeScript 5.9.3 (see the note at the top of tsconfig.base.json), so this is
# satisfied today. Kept so a future TS bump warns instead of failing the install.
strict-peer-dependencies=false
