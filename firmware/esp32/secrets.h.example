#pragma once

// Copy this file to `secrets.h` (same directory) and fill in real values:
//
//     cp firmware/esp32/secrets.h.example firmware/esp32/secrets.h
//
// `firmware/esp32/secrets.h` is listed in the repo .gitignore — it must never be
// committed. This example file carries placeholders only.
//
// It lives at the project root rather than in `include/` because that exact path
// is what .gitignore ignores; `src/main.cpp` includes it as "../secrets.h".

#define C67_SECRETS_HAS_MQTT 1

constexpr char WIFI_SSID[] = "your-wifi-ssid";
constexpr char WIFI_PASSWORD[] = "your-wifi-password";

constexpr char DEVICE_ID[] = "esp32-dev-001";
constexpr char MQTT_BROKER_HOST[] = "192.168.1.10";
constexpr uint16_t MQTT_BROKER_PORT = 8883;

// Paste PEMs generated by infra/local/mosquitto/certs/generate-certs.sh
// (ca.crt, esp32-dev-001.crt, esp32-dev-001.key). Keep the BEGIN/END lines.
constexpr char CA_CERT[] = R"EOF(
-----BEGIN CERTIFICATE-----
REPLACE_WITH_LOCAL_CA
-----END CERTIFICATE-----
)EOF";

constexpr char CLIENT_CERT[] = R"EOF(
-----BEGIN CERTIFICATE-----
REPLACE_WITH_DEVICE_CERT
-----END CERTIFICATE-----
)EOF";

constexpr char CLIENT_KEY[] = R"EOF(
-----BEGIN PRIVATE KEY-----
REPLACE_WITH_DEVICE_KEY
-----END PRIVATE KEY-----
)EOF";
