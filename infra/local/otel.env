# Sourced after fetch-otel-agent.sh. Service name is per process.
# JAVA_TOOL_OPTIONS must be an absolute -javaagent path. spring-boot:run's
# cwd is the module directory, so a relative path misses the jar.

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_INSTRUMENTATION_AWS_SDK_EXPERIMENTAL_USE_PROPAGATOR_FOR_MESSAGING=true
OTEL_INSTRUMENTATION_MESSAGING_EXPERIMENTAL_RECEIVE_TELEMETRY_ENABLED=true
OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
