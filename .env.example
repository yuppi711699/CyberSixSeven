# Copy to .env at the repo root (gitignored) and fill in real values.
# platform-api loads this file automatically at startup.

# Comma-separated exact browser origins for CORS (never "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Postgres (docker-compose + platform-api)
POSTGRES_PASSWORD=change-me
DB_PASSWORD=change-me

# platform-api internal service key (v0.3+)
INTERNAL_API_KEY=change-me-internal

# LocalStack (v0.3+)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-west-2
AWS_ENDPOINT_URL=http://localhost:4566

# model-gen-service (v0.4)
MODEL_GEN_QUEUE_URL=http://localhost:4566/000000000000/model-gen-jobs
ACCESSORY_BUCKET=cybersixseven-accessories
PLATFORM_API_BASE_URL=http://localhost:8080


# v0.5 auth (never commit real values)
JWT_SECRET=replace-with-at-least-32-byte-secret
REDIS_HOST=localhost
REDIS_PORT=6379
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
APP_PRODUCT_ENABLED=true
APP_FIXTURES_ENABLED=true
APP_OAUTH_FIXTURE_ENABLED=true
AUTH_COOKIE_SECURE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_PRODUCT_ENABLED=true
FIXTURE_TEACHER_EMAIL=teacher@example.test
FIXTURE_TEACHER_PASSWORD=replace-me
FIXTURE_ADMIN_EMAIL=admin@example.test
FIXTURE_ADMIN_PASSWORD=replace-me
